@model List<Car>

<div class="container">
	<div class="d-flex justify-content-between align-items-center my-3">
		<h1 class="mb-0">Booked Cars</h1>
		<a asp-action="Index" class="btn btn-primary">Back to Cars</a>
	</div>
</div>
@if (Model != null && Model.Count != 0)
{
	<div class="table-responsive">
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				<th>Id</th>
				<th>Car Name</th>
				<th>Price Per Day</th>
				<th>Status</th>
				</tr>
		</thead>
		<tbody>
			@foreach(var c in Model)
			{
				<tr>
					<td>@c.Id</td>
					<td>@c.Name</td>
					<td>@c.PricePerDay</td>
					<td><span class="badge bg-warning text-dark">Booked</span></td>
				</tr>
			}
		</tbody>
	</table>
	</div>
}
else
{
	<div class="alert alert-info">No Cars Booked</div>
}

